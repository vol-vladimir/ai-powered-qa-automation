# Run tests (required to clone and run Playwright)

# Didaxis Studio base URL — Playwright `baseURL`. No trailing slash.
DIDAXIS_URL=https://test.didaxis.studio

# Admin email for the auth setup project (`storageState`). Not a real inbox.
DIDAXIS_EMAIL=you@example.com

# Admin password. Keep the real value in `.env` only — never commit it.
DIDAXIS_PASSWORD=your-password

# Bearer token for `/api/programs` setup, teardown, and cleanup.
DIDAXIS_API_TOKEN=your-api-token

# Optional — alternate (non-admin) account for permission probes.
# Specs that skip unless set currently read DIDAXIS_NONADMIN_EMAIL / DIDAXIS_NONADMIN_PASSWORD;
# set those to the same values if you need those tests.
DIDAXIS_ALT_EMAIL=alt.user@example.com
DIDAXIS_ALT_PASSWORD=your-alt-password

# Agent / CI setup (not needed for npx playwright test alone)

# Cursor API key for the headless agent in `.github/workflows/test-generation.yml`.
CURSOR_API_KEY=your-cursor-api-key

# Atlassian API token (Jira). Also paste into Cursor Settings → MCP for the Atlassian server.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira Cloud site URL (no trailing slash).
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com
